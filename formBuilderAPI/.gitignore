## .NET / Visual Studio standard .gitignore

# Build results
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Ll]og/
[Ll]ogs/

# Visual Studio
.vs/
*.user
*.userosscache
*.suo
*.userprefs

# ReSharper / Rider
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.idea/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# MSBuild / build artifacts
*.binlog
*.pidb
*.svclog
*.dbmdl
*.dbproj.schemaview

# Test results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# Publish / deployment
[Pp]ublish/
*.publishsettings
PublishScripts/

# Rider / VS Code
*.sln.iml
.vscode/

# SQLite local database
*.db
*.db-shm
*.db-wal

# Runtime logs
*.log

# OS files
.DS_Store
Thumbs.db

# Secrets
*.pfx
appsettings.*.local.json
secrets.json
